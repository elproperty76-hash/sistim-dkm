{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FirebaseBlueprint",
  "description": "Blueprint schema for Mosque Management DKM Firestore database",
  "entities": {
    "mosqueProfile": {
      "collection": "mosque_profile",
      "schema": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "address": { "type": "string" },
          "callCenter": { "type": "string" },
          "updatedAt": { "type": "string" }
        },
        "required": ["name", "address", "callCenter"]
      },
      "rules": "allow read, write: if true;"
    },
    "jamaah": {
      "collection": "jamaah",
      "schema": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "role": { "type": "string" },
          "phone": { "type": "string" },
          "address": { "type": "string" },
          "category": { "type": "string" },
          "status": { "type": "string" },
          "joinedDate": { "type": "string" }
        },
        "required": ["name", "role"]
      },
      "rules": "allow read, write: if true;"
    },
    "keuangan": {
      "collection": "keuangan",
      "schema": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "date": { "type": "string" },
          "type": { "type": "string", "enum": ["IN", "OUT"] },
          "category": { "type": "string" },
          "amount": { "type": "number" },
          "description": { "type": "string" },
          "source": { "type": "string" }
        },
        "required": ["date", "type", "category", "amount"]
      },
      "rules": "allow read, write: if true;"
    },
    "aset": {
      "collection": "aset",
      "schema": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "category": { "type": "string" },
          "qty": { "type": "number" },
          "condition": { "type": "string" },
          "location": { "type": "string" },
          "year": { "type": "number" },
          "value": { "type": "number" }
        },
        "required": ["name", "category", "qty", "condition"]
      },
      "rules": "allow read, write: if true;"
    },
    "kegiatan": {
      "collection": "kegiatan",
      "schema": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "date": { "type": "string" },
          "category": { "type": "string" },
          "description": { "type": "string" },
          "image": { "type": "string" }
        },
        "required": ["title", "date", "category"]
      },
      "rules": "allow read, write: if true;"
    },
    "program": {
      "collection": "program",
      "schema": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "schedule": { "type": "string" },
          "speaker": { "type": "string" },
          "location": { "type": "string" },
          "target": { "type": "string" },
          "status": { "type": "string" }
        },
        "required": ["title", "schedule", "status"]
      },
      "rules": "allow read, write: if true;"
    },
    "broadcast": {
      "collection": "broadcast",
      "schema": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "date": { "type": "string" },
          "title": { "type": "string" },
          "recipient": { "type": "string" },
          "message": { "type": "string" },
          "status": { "type": "string" }
        },
        "required": ["title", "message"]
      },
      "rules": "allow read, write: if true;"
    },
    "users": {
      "collection": "users",
      "schema": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "email": { "type": "string" },
          "name": { "type": "string" },
          "role": { "type": "string" },
          "mosqueName": { "type": "string" },
          "createdAt": { "type": "string" }
        },
        "required": ["email", "name"]
      },
      "rules": "allow read, write: if true;"
    }
  }
}
